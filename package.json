{
	"name": "pi-extensions",
	"version": "0.2.1",
	"description": "A modular TUI and tool collection for Pi: header, editor, footer, live speed, telemetry, settings, and router-spec.",
	"type": "module",
	"license": "MIT",
	"keywords": [
		"pi-package",
		"pi-extension",
		"pi",
		"tui",
		"starship",
		"theme"
	],
	"files": [
		"shared/",
		"extensions/",
		"themes/",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"test": "node --test tests/*.test.ts tests/*.test.js",
		"typecheck": "tsc --noEmit",
		"release": "./scripts/release.sh"
	},
	"pi": {
		"extensions": [
			"./extensions/pi-header/index.ts",
			"./extensions/pi-editor/index.ts",
			"./extensions/pi-footer/index.ts",
			"./extensions/pi-metrics/index.ts",
			"./extensions/pi-settings/index.ts",
			"./extensions/pi-router-spec/index.ts",
			"./extensions/pi-chrome/index.ts",
			"./extensions/pi-ask/index.ts"
		],
		"themes": [
			"./themes"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": ">=0.80",
		"@earendil-works/pi-ai": ">=0.80",
		"@earendil-works/pi-tui": ">=0.80"
	},
	"peerDependenciesMeta": {
		"@earendil-works/pi-coding-agent": {
			"optional": true
		},
		"@earendil-works/pi-ai": {
			"optional": true
		},
		"@earendil-works/pi-tui": {
			"optional": true
		}
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-tui": "*",
		"@types/node": "^22.0.0",
		"typescript": "^5.5.0"
	}
}
