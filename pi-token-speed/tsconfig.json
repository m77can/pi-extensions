{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"allowImportingTsExtensions": false,
		"verbatimModuleSyntax": false,
		"forceConsistentCasingInFileNames": true,
		"types": ["node"]
	},
	"include": ["index.ts", "src/**/*.ts"]
}