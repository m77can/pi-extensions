import { readStoredCredential, type ExtensionAPI } from "@earendil-works/pi-coding-agent";

const DEFAULT_BASE_URL = "https://router.atomecorp.net/v1";

interface ArouterModel {
	id: string;
	description?: string;
	supported_protocols?: string[];
}

const DISPLAY_NAMES: Record<string, string> = {
	"gpt-5.5": "GPT-5.5",
	"gpt-5.4": "GPT-5.4",
	"gpt-5": "GPT-5",
	"gpt-5.4-mini": "GPT-5.4 Mini",
	"gpt-4o": "GPT-4o",
	"gpt-4o-mini": "GPT-4o Mini",
	"deepseek-v4-pro": "DeepSeek V4 Pro",
	"deepseek-v4-flash": "DeepSeek V4 Flash",
	fast: "Fast",
	smart: "Smart",
	"glm-5.2": "GLM 5.2",
	"gemini-3.1-pro-preview": "Gemini 3.1 Pro Preview",
	"claude-haiku-4-5": "Claude Haiku 4.5",
	"claude-haiku-4-5-20251001": "Claude Haiku 4.5 20251001",
	"claude-sonnet-4-6": "Claude Sonnet 4.6",
	"claude-opus-4-6": "Claude Opus 4.6",
	"claude-opus-4-7": "Claude Opus 4.7",
	"claude-opus-4-8": "Claude Opus 4.8",
	"opus-4-8": "Opus 4.8",
};

const ZERO_COST = { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 };

function displayName(modelId: string, description?: string): string {
	if (modelId in DISPLAY_NAMES) return DISPLAY_NAMES[modelId];
	if (description) {
		return description
			.replace(/_/g, "-")
			.split("-")
			.map((part) => part.charAt(0).toUpperCase() + part.slice(1))
			.join(" ");
	}
	return modelId;
}

function supportsVision(modelId: string): boolean {
	return (
		modelId.startsWith("claude-") ||
		modelId.startsWith("opus-") ||
		modelId.startsWith("gpt-4o") ||
		modelId.startsWith("gpt-5") ||
		modelId.startsWith("gemini-")
	);
}

function supportsChat(model: ArouterModel): boolean {
	const protocols = model.supported_protocols ?? [];
	return protocols.some((proto) => ["chat", "messages", "responses"].includes(proto));
}

function shouldSkip(modelId: string): boolean {
	return modelId.startsWith("text-embedding-");
}

function buildModelEntry(model: ArouterModel): ProviderModelConfig {
	const modelId = model.id;
	const name = displayName(modelId, model.description);

	if (modelId.startsWith("deepseek-v4-")) {
		return {
			id: modelId,
			name,
			reasoning: true,
			input: ["text"],
			contextWindow: 1_000_000,
			maxTokens: 384_000,
			cost: ZERO_COST,
			thinkingLevelMap: {
				minimal: null,
				low: null,
				medium: null,
				high: "high",
				xhigh: "max",
			},
			compat: {
				supportsStore: false,
				supportsDeveloperRole: false,
				supportsReasoningEffort: true,
				maxTokensField: "max_completion_tokens",
				requiresReasoningContentOnAssistantMessages: true,
				thinkingFormat: "deepseek",
			},
		};
	}

	if (modelId.startsWith("gpt-")) {
		return {
			id: modelId,
			name,
			reasoning: true,
			input: supportsVision(modelId) ? ["text", "image"] : ["text"],
			contextWindow: 272_000,
			maxTokens: 128_000,
			cost: ZERO_COST,
			compat: {
				supportsReasoningEffort: true,
				maxTokensField: "max_completion_tokens",
			},
		};
	}

	return {
		id: modelId,
		name,
		reasoning: false,
		input: supportsVision(modelId) ? ["text", "image"] : ["text"],
		contextWindow: 200_000,
		maxTokens: 64_000,
		cost: ZERO_COST,
	};
}

export default async function (pi: ExtensionAPI) {
	const credential = readStoredCredential("arouter");
	const apiKey = credential?.key;

	if (!apiKey) {
		throw new Error(
			'ARouter API key not found. Add to ~/.pi/agent/auth.json:\n' +
				'  { "arouter": { "type": "api_key", "key": "your-key" } }',
		);
	}

	const baseUrl = (process.env.AROUTER_BASE_URL ?? DEFAULT_BASE_URL).replace(/\/$/, "");

	const response = await fetch(`${baseUrl}/models`, {
		headers: { Authorization: `Bearer ${apiKey}` },
	});

	if (!response.ok) {
		const body = await response.text();
		throw new Error(`Failed to fetch arouter models: HTTP ${response.status} ${body}`);
	}

	const payload = (await response.json()) as { data?: ArouterModel[] };
	const data = payload.data;

	if (!Array.isArray(data)) {
		throw new Error(`Unexpected /models response: ${JSON.stringify(payload)}`);
	}

	const models = data
		.filter((model) => model.id && supportsChat(model) && !shouldSkip(model.id))
		.map(buildModelEntry);

	if (models.length === 0) {
		throw new Error("No chat-capable models found in arouter /models response.");
	}

	pi.registerProvider("arouter", {
		name: "ARouter",
		baseUrl,
		apiKey,
		api: "openai-completions",
		authHeader: true,
		models,
	});
}
